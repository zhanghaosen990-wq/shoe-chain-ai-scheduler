# 复制为 .env 后填入自己的 API 密钥。不要将 .env 提交或发送给任何人。
# 国内云服务器比赛部署：没有域名时直接用公网 IP；有域名再改成实际域名。
DOMAIN=:80

# DeepSeek（推荐本原型使用）：
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
# BOM 图片识别可按账号可用模型覆盖；不填写时沿用 AI_MODEL。
# DEEPSEEK_BOM_MODEL=deepseek-chat
# 若改用 OpenAI，则改为 AI_PROVIDER=openai，并填写：
# OPENAI_API_KEY=
# AI_MODEL=gpt-5.6-luna
